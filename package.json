{
  "name": "careflow-hospital-queue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/write-netlify-redirects.mjs",
    "preview": "vite preview",
    "start": "npm run build && tsx server/index.ts",
    "test": "vitest run",
    "server:dev": "tsx watch server/index.ts",
    "seed:admin": "tsx server/seed.ts",
    "backup:run": "tsx server/backup.ts",
    "staff:grant": "tsx server/createStaff.ts",
    "staff:remove": "tsx server/removeStaff.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
